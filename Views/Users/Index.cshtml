@model IEnumerable<AcxiomCRM.ViewModels.UserListItemViewModel>
@{
    ViewData["Title"] = "User & Role Administration";
    Layout = "_Layout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <h3 class="fw-bold mb-1 text-dark">User & Role Management</h3>
        <p class="text-muted small mb-0">Administer application access, assigned roles, password security, and account lockouts</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-person-plus-fill me-1"></i> Add New User
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small">
                    <tr>
                        <th>User</th>
                        <th>Role</th>
                        <th>Account Status</th>
                        <th>Security / Lockout</th>
                        <th>Created Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        var roleBadge = user.Role switch
                        {
                            "Admin" => "bg-danger",
                            "Manager" => "bg-primary",
                            _ => "bg-success"
                        };

                        <tr>
                            <td>
                                <div class="fw-bold text-dark">@user.FullName</div>
                                <div class="small text-muted">@user.Email</div>
                            </td>
                            <td>
                                <span class="badge @roleBadge">@user.Role</span>
                            </td>
                            <td>
                                <span class="badge @(user.IsActive ? "bg-success" : "bg-secondary")">
                                    @(user.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>
                                @if (user.IsLockedOut)
                                {
                                    <div>
                                        <span class="badge bg-danger">Locked Out</span>
                                        <div class="small text-danger">Until @user.LockoutEnd?.ToString("g")</div>
                                    </div>
                                }
                                else
                                {
                                    <span class="badge bg-light text-success border">
                                        <i class="bi bi-check-circle me-1"></i> Normal
                                    </span>
                                    @if (user.FailedLoginCount > 0)
                                    {
                                        <div class="small text-muted">@user.FailedLoginCount failed attempts</div>
                                    }
                                }
                            </td>
                            <td class="small text-muted">@user.CreatedDate.ToString("d")</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    @if (user.IsLockedOut)
                                    {
                                        <form asp-action="Unlock" asp-route-id="@user.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-warning" title="Unlock Account">
                                                <i class="bi bi-unlock"></i> Unlock
                                            </button>
                                        </form>
                                    }
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline-primary" title="Edit User">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="ResetPassword" asp-route-id="@user.Id" class="btn btn-outline-secondary" title="Reset Password">
                                        <i class="bi bi-key"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
