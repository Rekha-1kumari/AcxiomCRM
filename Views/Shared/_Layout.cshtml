<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AcxiomCRM</title>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }
        .navbar-brand {
            font-weight: 700;
            letter-spacing: -0.5px;
            color: #1e40af !important;
        }
        .navbar-brand span {
            color: #0284c7;
        }
        .nav-link {
            font-weight: 500;
            padding: 0.5rem 0.85rem !important;
            border-radius: 0.375rem;
            color: #475569;
            transition: all 0.15s ease-in-out;
        }
        .nav-link:hover, .nav-link.active {
            color: #1e40af;
            background-color: #eff6ff;
        }
        .card {
            border: 1px solid #e2e8f0;
            border-radius: 0.75rem;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
        }
        .btn-primary {
            background-color: #2563eb;
            border-color: #2563eb;
        }
        .btn-primary:hover {
            background-color: #1d4ed8;
            border-color: #1d4ed8;
        }
        .table > :not(caption) > * > * {
            padding: 0.75rem 1rem;
            vertical-align: middle;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand d-flex align-items-center me-4" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-diagram-3-fill text-primary fs-4 me-2"></i>
                    <span>Acxiom</span><span class="text-secondary fw-bold">CRM</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i>Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Customers" asp-action="Index">
                                    <i class="bi bi-people-fill me-1"></i>Customers
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Leads" asp-action="Index">
                                    <i class="bi bi-funnel-fill me-1"></i>Leads
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Opportunities" asp-action="Index">
                                    <i class="bi bi-graph-up-arrow me-1"></i>Opportunities
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="FollowUps" asp-action="Index">
                                    <i class="bi bi-calendar2-check me-1"></i>Follow-Ups
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Activities" asp-action="Index">
                                    <i class="bi bi-lightning-charge me-1"></i>Activities
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Reports" asp-action="Index">
                                    <i class="bi bi-bar-chart-line me-1"></i>Reports
                                </a>
                            </li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-danger fw-semibold" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-gear-fill me-1"></i>Administration
                                    </a>
                                    <ul class="dropdown-menu shadow border-0" aria-labelledby="adminDropdown">
                                        <li><a class="dropdown-item" asp-controller="Users" asp-action="Index"><i class="bi bi-person-lines-fill me-2"></i>User & Role Management</a></li>
                                        <li><a class="dropdown-item" asp-controller="AuditLogs" asp-action="Index"><i class="bi bi-shield-shaded me-2"></i>Security Audit Log</a></li>
                                    </ul>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0"></ul>
                    }
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1 py-4">
        <div class="container-fluid px-lg-4">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 d-flex align-items-center" role="alert">
                    <i class="bi bi-check-circle-fill fs-5 me-2"></i>
                    <div>@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 d-flex align-items-center" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
                    <div>@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </div>
    </main>

    <footer class="footer mt-auto py-3 bg-white border-top text-muted">
        <div class="container-fluid px-lg-4 d-flex flex-column flex-md-row justify-content-between align-items-center small">
            <div>
                &copy; @DateTime.UtcNow.Year <strong class="text-dark">AcxiomCRM</strong>. Role-Based Enterprise Customer Relationship Management.
            </div>
            <div class="mt-2 mt-md-0">
                <span class="badge bg-light text-dark border me-2">ASP.NET Core MVC</span>
                <span class="badge bg-light text-dark border me-2">EF Core & SQLite</span>
                <span class="badge bg-light text-dark border">ASP.NET Identity</span>
            </div>
        </div>
    </footer>

    <!-- Core Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
