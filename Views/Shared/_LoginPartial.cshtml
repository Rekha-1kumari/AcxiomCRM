@using Microsoft.AspNetCore.Identity
@using AcxiomCRM.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-center">
@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var displayName = currentUser?.FullName ?? User.Identity?.Name ?? "User";
    var role = User.IsInRole("Admin") ? "Admin" : User.IsInRole("Manager") ? "Manager" : "Sales Executive";
    var badgeClass = User.IsInRole("Admin") ? "bg-danger" : User.IsInRole("Manager") ? "bg-primary" : "bg-success";

    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle d-flex align-items-center text-dark" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <span class="badge @badgeClass me-2">@role</span>
            <span class="fw-semibold">@displayName</span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="userDropdown">
            <li><div class="dropdown-header text-muted small">Signed in as <br/><strong class="text-dark">@User.Identity?.Name</strong></div></li>
            <li><hr class="dropdown-divider"></li>
            @if (User.IsInRole("Admin"))
            {
                <li><a class="dropdown-item" asp-controller="Users" asp-action="Index"><i class="bi bi-people me-2"></i>User Admin</a></li>
                <li><a class="dropdown-item" asp-controller="AuditLogs" asp-action="Index"><i class="bi bi-shield-check me-2"></i>Audit Logs</a></li>
                <li><hr class="dropdown-divider"></li>
            }
            <li>
                <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark fw-medium" asp-controller="Account" asp-action="Register">Register</a>
    </li>
    <li class="nav-item">
        <a class="btn btn-primary btn-sm px-3 ms-2 rounded-pill" asp-controller="Account" asp-action="Login">Sign In</a>
    </li>
}
</ul>
