@model AcxiomCRM.ViewModels.CustomerInputModel
@{
    ViewData["Title"] = "Add Customer";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom pt-4 pb-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="fw-bold mb-1 text-dark">Create New Customer</h4>
                        <p class="text-muted small mb-0">Fill in the customer information below. All fields marked with * are required.</p>
                    </div>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Back to List
                    </a>
                </div>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post" id="customerForm" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="CustomerCode" class="form-label fw-semibold small text-muted"></label>
                            <input asp-for="CustomerCode" class="form-control bg-light" readonly />
                            <span asp-validation-for="CustomerCode" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CustomerName" class="form-label fw-semibold small text-dark">Customer Name <span class="text-danger">*</span></label>
                            <input asp-for="CustomerName" class="form-control" placeholder="e.g. Ramesh Kumar" />
                            <span asp-validation-for="CustomerName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold small text-dark">Email Address <span class="text-danger">*</span></label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="ramesh@company.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold small text-dark">Phone Number (10 digits) <span class="text-danger">*</span></label>
                            <input asp-for="Phone" class="form-control" placeholder="9876543210" maxlength="10" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="CompanyName" class="form-label fw-semibold small text-muted"></label>
                            <input asp-for="CompanyName" class="form-control" placeholder="e.g. Acme Innovations Pvt Ltd" />
                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Address" class="form-label fw-semibold small text-muted"></label>
                            <input asp-for="Address" class="form-control" placeholder="Street Address, Area" />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="City" class="form-label fw-semibold small text-muted"></label>
                            <input asp-for="City" class="form-control" placeholder="City" />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="State" class="form-label fw-semibold small text-muted"></label>
                            <input asp-for="State" class="form-control" placeholder="State" />
                            <span asp-validation-for="State" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-semibold small text-dark">Account Status <span class="text-danger">*</span></label>
                            <select asp-for="Status" class="form-select">
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        @if (!User.IsInRole("SalesExecutive"))
                        {
                            <div class="col-md-6">
                                <label asp-for="AssignedTo" class="form-label fw-semibold small text-muted"></label>
                                <select asp-for="AssignedTo" asp-items="ViewBag.UsersList" class="form-select">
                                    <option value="">-- Assign Sales Executive --</option>
                                </select>
                                <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 shadow-sm">
                            <i class="bi bi-save me-1"></i> Save Customer
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
