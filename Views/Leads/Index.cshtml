@model IEnumerable<AcxiomCRM.Models.Lead>
@{
    ViewData["Title"] = "Lead Management";
    var usersLookup = ViewBag.UsersLookup as Dictionary<string, string> ?? new();
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <h3 class="fw-bold mb-1 text-dark">Lead Management</h3>
        <p class="text-muted small mb-0">Total @ViewBag.TotalCount prospective leads captured</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-funnel-fill me-1"></i> Capture Lead
        </a>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control border-start-0" placeholder="Search by lead name, email, phone, company..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="New" selected="@(ViewBag.Status == "New")">New</option>
                    <option value="Contacted" selected="@(ViewBag.Status == "Contacted")">Contacted</option>
                    <option value="Qualified" selected="@(ViewBag.Status == "Qualified")">Qualified</option>
                    <option value="Converted" selected="@(ViewBag.Status == "Converted")">Converted</option>
                    <option value="Lost" selected="@(ViewBag.Status == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="source" class="form-select">
                    <option value="">All Sources</option>
                    <option value="Website" selected="@(ViewBag.Source == "Website")">Website</option>
                    <option value="Referral" selected="@(ViewBag.Source == "Referral")">Referral</option>
                    <option value="Cold Call" selected="@(ViewBag.Source == "Cold Call")">Cold Call</option>
                    <option value="Advertisement" selected="@(ViewBag.Source == "Advertisement")">Advertisement</option>
                    <option value="Partner" selected="@(ViewBag.Source == "Partner")">Partner</option>
                </select>
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-outline-secondary">Filter</button>
            </div>
        </form>
    </div>
</div>

<!-- Leads Table Card -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small">
                    <tr>
                        <th>Code</th>
                        <th>Lead Name</th>
                        <th>Company</th>
                        <th>Source</th>
                        <th>Expected Value</th>
                        <th>Status</th>
                        <th>Assigned To</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var assignedName = !string.IsNullOrEmpty(item.AssignedTo) && usersLookup.ContainsKey(item.AssignedTo)
                                ? usersLookup[item.AssignedTo]
                                : "Unassigned";

                            var badgeColor = item.Status switch
                            {
                                "New" => "bg-primary",
                                "Contacted" => "bg-info text-dark",
                                "Qualified" => "bg-warning text-dark",
                                "Converted" => "bg-success",
                                "Lost" => "bg-danger",
                                _ => "bg-secondary"
                            };

                            <tr>
                                <td><span class="badge bg-light text-dark border font-monospace">@item.LeadCode</span></td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.LeadId" class="fw-bold text-dark text-decoration-none">
                                        @item.LeadName
                                    </a>
                                    <div class="small text-muted">@item.Email | @item.Phone</div>
                                </td>
                                <td>@(item.CompanyName ?? "-")</td>
                                <td><span class="badge bg-light text-dark border">@item.Source</span></td>
                                <td class="fw-bold text-dark">₹@item.ExpectedValue.ToString("N0")</td>
                                <td><span class="badge @badgeColor">@item.Status</span></td>
                                <td><span class="small text-muted">@assignedName</span></td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        @if (item.Status != "Converted")
                                        {
                                            <a asp-action="Convert" asp-route-id="@item.LeadId" class="btn btn-outline-success" title="Convert Lead">
                                                <i class="bi bi-arrow-repeat"></i> Convert
                                            </a>
                                        }
                                        <a asp-action="Details" asp-route-id="@item.LeadId" class="btn btn-outline-secondary" title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.LeadId" class="btn btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                        {
                                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.LeadId" title="Mark Lost">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        }
                                    </div>

                                    <!-- Delete Modal -->
                                    <div class="modal fade text-start" id="deleteModal-@item.LeadId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header border-0">
                                                    <h5 class="modal-title fw-bold text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Mark Lead Lost</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body py-2">
                                                    Are you sure you want to mark lead <strong>@item.LeadName</strong> as Lost?
                                                </div>
                                                <div class="modal-footer border-0">
                                                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                    <form asp-action="Delete" asp-route-id="@item.LeadId" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger">Confirm Lost</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-funnel fs-2 d-block mb-2 text-secondary"></i>
                                No leads found matching criteria.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (totalPages > 1)
    {
        <div class="card-footer bg-white border-0 py-3">
            <ul class="pagination pagination-sm justify-content-center mb-0">
                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status" asp-route-source="@ViewBag.Source">@p</a>
                    </li>
                }
            </ul>
        </div>
    }
</div>
