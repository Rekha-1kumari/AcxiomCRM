@model AcxiomCRM.ViewModels.LeadInputModel
@{
    ViewData["Title"] = "Capture Lead";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom pt-4 pb-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="fw-bold mb-1 text-dark">Capture New Lead</h4>
                        <p class="text-muted small mb-0">Record details of prospective client. All fields marked with * are required.</p>
                    </div>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Back to List
                    </a>
                </div>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="LeadCode" class="form-label fw-semibold small text-muted"></label>
                            <input asp-for="LeadCode" class="form-control bg-light" readonly />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LeadName" class="form-label fw-semibold small text-dark">Lead Name <span class="text-danger">*</span></label>
                            <input asp-for="LeadName" class="form-control" placeholder="e.g. Ankit Sharma" />
                            <span asp-validation-for="LeadName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold small text-dark">Email Address <span class="text-danger">*</span></label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="ankit@startup.io" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold small text-dark">Phone Number (10 digits) <span class="text-danger">*</span></label>
                            <input asp-for="Phone" class="form-control" placeholder="9876543210" maxlength="10" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CompanyName" class="form-label fw-semibold small text-muted"></label>
                            <input asp-for="CompanyName" class="form-control" placeholder="e.g. Zenith Tech Solutions" />
                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Source" class="form-label fw-semibold small text-dark">Lead Source <span class="text-danger">*</span></label>
                            <select asp-for="Source" class="form-select">
                                <option value="Website">Website</option>
                                <option value="Referral">Referral</option>
                                <option value="Cold Call">Cold Call</option>
                                <option value="Advertisement">Advertisement</option>
                                <option value="Partner">Partner</option>
                                <option value="Other">Other</option>
                            </select>
                            <span asp-validation-for="Source" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-semibold small text-dark">Lead Status <span class="text-danger">*</span></label>
                            <select asp-for="Status" class="form-select">
                                <option value="New">New</option>
                                <option value="Contacted">Contacted</option>
                                <option value="Qualified">Qualified</option>
                                <option value="Unqualified">Unqualified</option>
                                <option value="Lost">Lost</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ExpectedValue" class="form-label fw-semibold small text-dark">Expected Deal Value (₹) <span class="text-danger">*</span></label>
                            <input asp-for="ExpectedValue" type="number" step="0.01" class="form-control" placeholder="500000" />
                            <span asp-validation-for="ExpectedValue" class="text-danger small"></span>
                        </div>

                        @if (!User.IsInRole("SalesExecutive"))
                        {
                            <div class="col-md-12">
                                <label asp-for="AssignedTo" class="form-label fw-semibold small text-muted"></label>
                                <select asp-for="AssignedTo" asp-items="ViewBag.UsersList" class="form-select">
                                    <option value="">-- Assign Sales Executive --</option>
                                </select>
                                <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 shadow-sm">
                            <i class="bi bi-save me-1"></i> Save Lead
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
