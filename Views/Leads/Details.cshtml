@model AcxiomCRM.ViewModels.LeadDetailsViewModel
@{
    ViewData["Title"] = "Lead Details - " + Model.Lead.LeadName;
    Layout = "_Layout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h3 class="fw-bold mb-0 text-dark">@Model.Lead.LeadName</h3>
            <span class="badge @(Model.Lead.Status == "Converted" ? "bg-success" : Model.Lead.Status == "Lost" ? "bg-danger" : "bg-primary")">
                @Model.Lead.Status
            </span>
        </div>
        <p class="text-muted small mb-0 font-monospace">@Model.Lead.LeadCode | Source: @Model.Lead.Source | Captured on @Model.Lead.CreatedDate.ToString("D")</p>
    </div>
    <div class="d-flex gap-2">
        @if (Model.Lead.Status != "Converted")
        {
            <a asp-action="Convert" asp-route-id="@Model.Lead.LeadId" class="btn btn-success btn-sm shadow-sm">
                <i class="bi bi-arrow-repeat me-1"></i> Convert Lead
            </a>
        }
        <a asp-action="Edit" asp-route-id="@Model.Lead.LeadId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        <a asp-controller="FollowUps" asp-action="Create" asp-route-leadId="@Model.Lead.LeadId" class="btn btn-outline-warning btn-sm">
            <i class="bi bi-calendar-plus me-1"></i> Follow-up
        </a>
        <a asp-action="Index" class="btn btn-light btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Lead Profile Info -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-transparent border-bottom pt-3">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-funnel-fill text-primary me-2"></i>Lead Profile</h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="text-muted small fw-semibold d-block">Expected Deal Value</label>
                    <h4 class="fw-bold text-success mb-0">₹@Model.Lead.ExpectedValue.ToString("N0")</h4>
                </div>
                <div class="mb-3">
                    <label class="text-muted small fw-semibold d-block">Company</label>
                    <div class="fw-bold text-dark">@(Model.Lead.CompanyName ?? "-")</div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small fw-semibold d-block">Email</label>
                    <div><a href="mailto:@Model.Lead.Email" class="text-decoration-none">@Model.Lead.Email</a></div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small fw-semibold d-block">Phone</label>
                    <div><a href="tel:@Model.Lead.Phone" class="text-decoration-none">@Model.Lead.Phone</a></div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small fw-semibold d-block">Lead Source</label>
                    <div class="badge bg-light text-dark border">@Model.Lead.Source</div>
                </div>
                <div class="mb-0">
                    <label class="text-muted small fw-semibold d-block">Assigned Representative</label>
                    <div class="badge bg-light text-dark border">@(Model.AssignedUserName ?? "Unassigned")</div>
                </div>
            </div>
        </div>

        @if (Model.Lead.Status == "Converted")
        {
            <div class="card border-0 shadow-sm bg-light">
                <div class="card-body">
                    <h6 class="fw-bold text-success mb-2"><i class="bi bi-check-circle-fill me-1"></i> Converted Details</h6>
                    @if (Model.ConvertedCustomer != null)
                    {
                        <div class="small mb-1">
                            Customer: <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.ConvertedCustomer.CustomerId" class="fw-bold">@Model.ConvertedCustomer.CustomerName</a>
                        </div>
                    }
                    @if (Model.ConvertedOpportunity != null)
                    {
                        <div class="small">
                            Opportunity: <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@Model.ConvertedOpportunity.OpportunityId" class="fw-bold">@Model.ConvertedOpportunity.OpportunityName</a>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Related Follow-Ups and Activities -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom pt-3">
                <ul class="nav nav-tabs card-header-tabs" id="leadTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-semibold" id="followups-tab" data-bs-toggle="tab" data-bs-target="#followups" type="button" role="tab">
                            Follow-Ups (@Model.FollowUps.Count)
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-semibold" id="activities-tab" data-bs-toggle="tab" data-bs-target="#activities" type="button" role="tab">
                            Activities (@Model.Activities.Count)
                        </button>
                    </li>
                </ul>
            </div>
            <div class="card-body p-0">
                <div class="tab-content" id="leadTabsContent">
                    <!-- Tab 1: FollowUps -->
                    <div class="tab-pane fade show active p-3" id="followups" role="tabpanel">
                        @if (Model.FollowUps.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light text-muted small">
                                        <tr>
                                            <th>Type</th>
                                            <th>Date & Time</th>
                                            <th>Remarks</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var f in Model.FollowUps)
                                        {
                                            <tr>
                                                <td><span class="badge bg-light text-dark border">@f.FollowUpType</span></td>
                                                <td class="small fw-semibold">@f.FollowUpDate.ToString("g")</td>
                                                <td class="small">@f.Remarks</td>
                                                <td>
                                                    <span class="badge @(f.Status == "Completed" ? "bg-success" : f.Status == "Planned" ? "bg-warning text-dark" : "bg-danger")">
                                                        @f.Status
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted small">No follow-ups recorded for this lead yet.</div>
                        }
                    </div>

                    <!-- Tab 2: Activities -->
                    <div class="tab-pane fade p-3" id="activities" role="tabpanel">
                        @if (Model.Activities.Any())
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var a in Model.Activities)
                                {
                                    <div class="list-group-item px-0 py-2">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="badge bg-primary bg-opacity-10 text-primary">@a.ActivityType</span>
                                            <span class="text-muted small">@a.ActivityDate.ToString("g")</span>
                                        </div>
                                        <div class="fw-semibold text-dark">@a.Subject</div>
                                        @if (!string.IsNullOrEmpty(a.Description))
                                        {
                                            <div class="small text-muted">@a.Description</div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted small">No past interactions logged for this lead.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
