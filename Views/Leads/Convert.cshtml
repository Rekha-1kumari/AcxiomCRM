@model AcxiomCRM.ViewModels.LeadConvertViewModel
@{
    ViewData["Title"] = "Convert Lead - " + Model.LeadName;
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom pt-4 pb-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="fw-bold mb-1 text-success"><i class="bi bi-arrow-repeat me-2"></i>Convert Qualified Lead</h4>
                        <p class="text-muted small mb-0">Convert prospective lead into an active Customer Account and Sales Deal</p>
                    </div>
                    <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Cancel
                    </a>
                </div>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-info py-2 small d-flex align-items-center mb-4">
                    <i class="bi bi-info-circle-fill fs-5 me-2"></i>
                    <div>Converting <strong>@Model.LeadName</strong> (@(Model.CompanyName ?? "Individual")) &mdash; @Model.Email</div>
                </div>

                <form asp-action="Convert" asp-route-id="@Model.LeadId" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="LeadId" />
                    <input type="hidden" asp-for="LeadName" />
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="Phone" />
                    <input type="hidden" asp-for="CompanyName" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <!-- Step 1: Customer Record -->
                    <div class="card border border-light-subtle shadow-none mb-4">
                        <div class="card-body">
                            <div class="form-check form-switch mb-3">
                                <input asp-for="CreateCustomer" class="form-check-input" type="checkbox" id="checkCreateCustomer" checked />
                                <label class="form-check-label fw-bold text-dark" for="checkCreateCustomer">
                                    Create Customer Account
                                </label>
                            </div>
                            <div class="small text-muted">
                                Automatically registers <strong>@Model.LeadName</strong> as an active customer in the CRM database with email <code>@Model.Email</code> and phone <code>@Model.Phone</code>.
                            </div>
                        </div>
                    </div>

                    <!-- Step 2: Opportunity Record -->
                    <div class="card border border-light-subtle shadow-none mb-4">
                        <div class="card-body">
                            <div class="form-check form-switch mb-3">
                                <input asp-for="CreateOpportunity" class="form-check-input" type="checkbox" id="checkCreateOpportunity" checked />
                                <label class="form-check-label fw-bold text-dark" for="checkCreateOpportunity">
                                    Create Sales Opportunity
                                </label>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-12">
                                    <label asp-for="OpportunityName" class="form-label fw-semibold small text-dark"></label>
                                    <input asp-for="OpportunityName" class="form-control" />
                                    <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="OpportunityAmount" class="form-label fw-semibold small text-dark">Deal Amount (₹) <span class="text-danger">*</span></label>
                                    <input asp-for="OpportunityAmount" type="number" step="0.01" class="form-control" />
                                    <span asp-validation-for="OpportunityAmount" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="OpportunityStage" class="form-label fw-semibold small text-dark"></label>
                                    <select asp-for="OpportunityStage" class="form-select">
                                        <option value="Qualification">Qualification</option>
                                        <option value="Proposal">Proposal</option>
                                        <option value="Negotiation">Negotiation</option>
                                    </select>
                                    <span asp-validation-for="OpportunityStage" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Probability" class="form-label fw-semibold small text-dark">Win Probability (%)</label>
                                    <input asp-for="Probability" type="number" min="0" max="100" class="form-control" />
                                    <span asp-validation-for="Probability" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="ExpectedCloseDate" class="form-label fw-semibold small text-dark"></label>
                                    <input asp-for="ExpectedCloseDate" type="date" class="form-control" />
                                    <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                        <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-light px-4">Cancel</a>
                        <button type="submit" class="btn btn-success px-4 shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Complete Conversion
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
