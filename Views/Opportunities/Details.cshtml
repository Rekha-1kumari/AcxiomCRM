@model AcxiomCRM.ViewModels.OpportunityDetailsViewModel
@{
    ViewData["Title"] = "Opportunity Details - " + Model.Opportunity.OpportunityName;
    Layout = "_Layout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h3 class="fw-bold mb-0 text-dark">@Model.Opportunity.OpportunityName</h3>
            <span class="badge @(Model.Opportunity.Status == "Won" ? "bg-success" : Model.Opportunity.Status == "Lost" ? "bg-danger" : "bg-primary")">
                @Model.Opportunity.Status
            </span>
            <span class="badge bg-info text-dark">@Model.Opportunity.Stage</span>
        </div>
        <p class="text-muted small mb-0">Created on @Model.Opportunity.CreatedDate.ToString("D")</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Opportunity.OpportunityId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        <a asp-controller="FollowUps" asp-action="Create" asp-route-opportunityId="@Model.Opportunity.OpportunityId" class="btn btn-outline-warning btn-sm">
            <i class="bi bi-calendar-plus me-1"></i> Follow-up
        </a>
        <a asp-action="Index" class="btn btn-light btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Deal Financial Summary -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-transparent border-bottom pt-3">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-cash-stack text-success me-2"></i>Commercial Terms</h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="text-muted small fw-semibold d-block">Deal Amount</label>
                    <h3 class="fw-bold text-primary mb-0">₹@Model.Opportunity.Amount.ToString("N0")</h3>
                </div>
                <div class="mb-3">
                    <label class="text-muted small fw-semibold d-block">Win Probability</label>
                    <div class="d-flex align-items-center gap-2">
                        <div class="progress flex-grow-1" style="height: 8px;">
                            <div class="progress-bar bg-success" style="width: @Model.Opportunity.Probability%"></div>
                        </div>
                        <span class="fw-bold text-dark">@Model.Opportunity.Probability%</span>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small fw-semibold d-block">Weighted Pipeline Value</label>
                    <h5 class="fw-bold text-secondary mb-0">₹@Model.Opportunity.WeightedAmount.ToString("N0")</h5>
                    <div class="text-muted small">Calculation: Amount × Probability ÷ 100</div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small fw-semibold d-block">Target Close Date</label>
                    <div class="fw-semibold text-dark">@Model.Opportunity.ExpectedCloseDate.ToString("D")</div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small fw-semibold d-block">Associated Account</label>
                    @if (Model.Opportunity.Customer != null)
                    {
                        <div><a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.Opportunity.Customer.CustomerId">@Model.Opportunity.Customer.CustomerName</a></div>
                    }
                    else if (Model.Opportunity.Lead != null)
                    {
                        <div><a asp-controller="Leads" asp-action="Details" asp-route-id="@Model.Opportunity.Lead.LeadId">@Model.Opportunity.Lead.LeadName</a></div>
                    }
                    else
                    {
                        <div class="text-muted">-</div>
                    }
                </div>
                <div class="mb-0">
                    <label class="text-muted small fw-semibold d-block">Opportunity Owner</label>
                    <div class="badge bg-light text-dark border">@(Model.AssignedUserName ?? "Unassigned")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Deal Notes & Linked Follow-Ups -->
    <div class="col-lg-8">
        @if (!string.IsNullOrEmpty(Model.Opportunity.Notes))
        {
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-transparent border-bottom pt-3">
                    <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-sticky text-warning me-2"></i>Deal Notes & Strategy</h6>
                </div>
                <div class="card-body">
                    <p class="mb-0 text-secondary" style="white-space: pre-wrap;">@Model.Opportunity.Notes</p>
                </div>
            </div>
        }

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom pt-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-calendar2-check text-primary me-2"></i>Follow-Up Schedule</h6>
                <a asp-controller="FollowUps" asp-action="Create" asp-route-opportunityId="@Model.Opportunity.OpportunityId" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-plus"></i> Add Follow-up
                </a>
            </div>
            <div class="card-body p-0">
                @if (Model.FollowUps.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-muted small">
                                <tr>
                                    <th>Type</th>
                                    <th>Date</th>
                                    <th>Remarks</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var f in Model.FollowUps)
                                {
                                    <tr>
                                        <td><span class="badge bg-light text-dark border">@f.FollowUpType</span></td>
                                        <td class="small fw-semibold">@f.FollowUpDate.ToString("g")</td>
                                        <td class="small">@f.Remarks</td>
                                        <td>
                                            <span class="badge @(f.Status == "Completed" ? "bg-success" : f.Status == "Planned" ? "bg-warning text-dark" : "bg-danger")">
                                                @f.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted small">No scheduled follow-up activities.</div>
                }
            </div>
        </div>
    </div>
</div>
