@model AcxiomCRM.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "CRM Dashboard";
    Layout = "_Layout";
}

<!-- Dashboard Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1 text-dark">Welcome back, @Model.UserFullName</h2>
        <div class="d-flex align-items-center gap-2">
            <span class="badge @(Model.UserRole == "Admin" ? "bg-danger" : Model.UserRole == "Manager" ? "bg-primary" : "bg-success")">
                @Model.UserRole Mode
            </span>
            <span class="text-muted small">Here is your real-time sales pipeline summary</span>
        </div>
    </div>
    <!-- Date Filter Buttons -->
    <div class="btn-group shadow-sm" role="group" aria-label="Date Filter">
        <a asp-action="Index" asp-route-dateFilter="Today" class="btn btn-outline-secondary btn-sm @(Model.DateFilter == "Today" ? "active" : "")">Today</a>
        <a asp-action="Index" asp-route-dateFilter="ThisWeek" class="btn btn-outline-secondary btn-sm @(Model.DateFilter == "ThisWeek" ? "active" : "")">This Week</a>
        <a asp-action="Index" asp-route-dateFilter="ThisMonth" class="btn btn-outline-secondary btn-sm @(Model.DateFilter == "ThisMonth" ? "active" : "")">This Month</a>
        <a asp-action="Index" asp-route-dateFilter="All" class="btn btn-outline-secondary btn-sm @(Model.DateFilter == "All" || string.IsNullOrEmpty(Model.DateFilter) ? "active" : "")">All Time</a>
    </div>
</div>

<!-- 8 Mandatory KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card h-100 border-0 shadow-sm bg-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold">Total Customers</span>
                    <div class="p-2 bg-primary bg-opacity-10 text-primary rounded-3"><i class="bi bi-people-fill"></i></div>
                </div>
                <h3 class="fw-bold text-dark mb-0">@Model.TotalCustomers</h3>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card h-100 border-0 shadow-sm bg-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold">Total Leads</span>
                    <div class="p-2 bg-info bg-opacity-10 text-info rounded-3"><i class="bi bi-funnel-fill"></i></div>
                </div>
                <h3 class="fw-bold text-dark mb-0">@Model.TotalLeads</h3>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card h-100 border-0 shadow-sm bg-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold">Open Leads</span>
                    <div class="p-2 bg-warning bg-opacity-10 text-warning rounded-3"><i class="bi bi-hourglass-split"></i></div>
                </div>
                <h3 class="fw-bold text-dark mb-0">@Model.OpenLeads</h3>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card h-100 border-0 shadow-sm bg-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold">Total Opportunities</span>
                    <div class="p-2 bg-secondary bg-opacity-10 text-secondary rounded-3"><i class="bi bi-collection-fill"></i></div>
                </div>
                <h3 class="fw-bold text-dark mb-0">@Model.TotalOpportunities</h3>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="card h-100 border-0 shadow-sm bg-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold">Open Opportunities</span>
                    <div class="p-2 bg-primary bg-opacity-10 text-primary rounded-3"><i class="bi bi-folder2-open"></i></div>
                </div>
                <h3 class="fw-bold text-dark mb-0">@Model.OpenOpportunities</h3>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card h-100 border-0 shadow-sm bg-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold">Won Opportunities</span>
                    <div class="p-2 bg-success bg-opacity-10 text-success rounded-3"><i class="bi bi-trophy-fill"></i></div>
                </div>
                <h3 class="fw-bold text-success mb-0">@Model.WonOpportunities</h3>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card h-100 border-0 shadow-sm bg-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold">Lost Opportunities</span>
                    <div class="p-2 bg-danger bg-opacity-10 text-danger rounded-3"><i class="bi bi-x-circle-fill"></i></div>
                </div>
                <h3 class="fw-bold text-danger mb-0">@Model.LostOpportunities</h3>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card h-100 border-0 shadow-sm bg-primary text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small fw-semibold text-white-50">Total Pipeline Value</span>
                    <div class="p-2 bg-white bg-opacity-20 text-white rounded-3"><i class="bi bi-currency-rupee"></i></div>
                </div>
                <h3 class="fw-bold text-white mb-0">₹@Model.TotalPipelineValue.ToString("N0")</h3>
                <div class="small text-white-50 mt-1">Weighted: ₹@Model.WeightedPipelineValue.ToString("N0")</div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row g-4 mb-4">
    <!-- Chart 1: Lead Status -->
    <div class="col-lg-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-header bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-pie-chart-fill text-info me-2"></i>Lead Status Breakdown</h6>
            </div>
            <div class="card-body d-flex justify-content-center align-items-center" style="min-height: 280px;">
                <canvas id="leadStatusChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Chart 2: Pipeline by Stage -->
    <div class="col-lg-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-header bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-bar-chart-fill text-primary me-2"></i>Pipeline Value by Stage</h6>
            </div>
            <div class="card-body d-flex justify-content-center align-items-center" style="min-height: 280px;">
                <canvas id="pipelineStageChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Chart 3: Monthly Sales -->
    <div class="col-lg-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-header bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-graph-up text-success me-2"></i>Monthly Sales Trend</h6>
            </div>
            <div class="card-body d-flex justify-content-center align-items-center" style="min-height: 280px;">
                <canvas id="monthlySalesChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Activity & Follow-Up Row -->
<div class="row g-4">
    <!-- Upcoming Follow-Ups -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pt-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-calendar2-event-fill text-warning me-2"></i>Upcoming Planned Follow-Ups</h6>
                <a asp-controller="FollowUps" asp-action="Create" class="btn btn-outline-primary btn-sm"><i class="bi bi-plus"></i> Schedule</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted small">
                            <tr>
                                <th>Type</th>
                                <th>Date & Time</th>
                                <th>Remarks</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.UpcomingFollowUps.Any())
                            {
                                foreach (var f in Model.UpcomingFollowUps)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-light text-dark border">
                                                <i class="bi @(f.FollowUpType == "Call" ? "bi-telephone" : f.FollowUpType == "Meeting" ? "bi-camera-video" : "bi-envelope") me-1"></i>
                                                @f.FollowUpType
                                            </span>
                                        </td>
                                        <td class="small fw-semibold">@f.FollowUpDate.ToString("g")</td>
                                        <td class="small text-truncate" style="max-width: 200px;">@f.Remarks</td>
                                        <td>
                                            <form asp-controller="FollowUps" asp-action="MarkComplete" asp-route-id="@f.FollowUpId" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-success py-0 px-2" title="Mark Done">
                                                    <i class="bi bi-check2"></i> Done
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4 small">No upcoming planned follow-ups.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- High-Value Opportunities -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pt-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-fire text-danger me-2"></i>Top Open Opportunities</h6>
                <a asp-controller="Opportunities" asp-action="Create" class="btn btn-outline-primary btn-sm"><i class="bi bi-plus"></i> New Deal</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted small">
                            <tr>
                                <th>Opportunity</th>
                                <th>Amount</th>
                                <th>Stage</th>
                                <th>Close Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.HighValueOpportunities.Any())
                            {
                                foreach (var o in Model.HighValueOpportunities)
                                {
                                    <tr>
                                        <td class="fw-semibold small">
                                            <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@o.OpportunityId" class="text-decoration-none text-dark">
                                                @o.OpportunityName
                                            </a>
                                        </td>
                                        <td class="fw-bold text-primary small">₹@o.Amount.ToString("N0")</td>
                                        <td><span class="badge bg-info text-dark small">@o.Stage (@o.Probability%)</span></td>
                                        <td class="small text-muted">@o.ExpectedCloseDate.ToString("d")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4 small">No open opportunities found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 1. Lead Status Chart
        const leadLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusLabels));
        const leadCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusCounts));

        new Chart(document.getElementById('leadStatusChart'), {
            type: 'doughnut',
            data: {
                labels: leadLabels,
                datasets: [{
                    data: leadCounts,
                    backgroundColor: ['#3b82f6', '#06b6d4', '#10b981', '#6366f1', '#ef4444'],
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom' }
                }
            }
        });

        // 2. Opportunity Pipeline Stage Chart
        const stageLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PipelineStageLabels));
        const stageAmounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PipelineStageAmounts));

        new Chart(document.getElementById('pipelineStageChart'), {
            type: 'bar',
            data: {
                labels: stageLabels,
                datasets: [{
                    label: 'Pipeline Value (₹)',
                    data: stageAmounts,
                    backgroundColor: '#3b82f6',
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(val) { return '₹' + val.toLocaleString(); }
                        }
                    }
                }
            }
        });

        // 3. Monthly Sales Chart
        const monthlyLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesLabels));
        const monthlyAmounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesAmounts));

        new Chart(document.getElementById('monthlySalesChart'), {
            type: 'line',
            data: {
                labels: monthlyLabels,
                datasets: [{
                    label: 'Won Deals (₹)',
                    data: monthlyAmounts,
                    borderColor: '#10b981',
                    backgroundColor: 'rgba(16, 185, 129, 0.1)',
                    fill: true,
                    tension: 0.3,
                    pointRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(val) { return '₹' + val.toLocaleString(); }
                        }
                    }
                }
            }
        });
    </script>
}
