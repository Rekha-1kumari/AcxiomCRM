@model IEnumerable<AcxiomCRM.Models.Activity>
@{
    ViewData["Title"] = "Activity Management";
    var usersLookup = ViewBag.UsersLookup as Dictionary<string, string> ?? new();
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <h3 class="fw-bold mb-1 text-dark">Activity Management</h3>
        <p class="text-muted small mb-0">Total @ViewBag.TotalCount customer touchpoints logged</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Log Activity
        </a>
    </div>
</div>

<!-- Filter Card -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-5">
                <select name="type" class="form-select">
                    <option value="">All Activity Types</option>
                    <option value="Call" selected="@(ViewBag.Type == "Call")">Call</option>
                    <option value="Meeting" selected="@(ViewBag.Type == "Meeting")">Meeting</option>
                    <option value="Email" selected="@(ViewBag.Type == "Email")">Email</option>
                    <option value="Task" selected="@(ViewBag.Type == "Task")">Task</option>
                </select>
            </div>
            <div class="col-md-5">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Completed" selected="@(ViewBag.Status == "Completed")">Completed</option>
                    <option value="Planned" selected="@(ViewBag.Status == "Planned")">Planned</option>
                    <option value="Cancelled" selected="@(ViewBag.Status == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-outline-secondary">Filter</button>
            </div>
        </form>
    </div>
</div>

<!-- Table Card -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small">
                    <tr>
                        <th>Type</th>
                        <th>Subject & Notes</th>
                        <th>Associated With</th>
                        <th>Date & Time</th>
                        <th>Status</th>
                        <th>Owner</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var assignedName = !string.IsNullOrEmpty(item.AssignedTo) && usersLookup.ContainsKey(item.AssignedTo)
                                ? usersLookup[item.AssignedTo]
                                : "Unassigned";

                            <tr>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi @(item.ActivityType == "Call" ? "bi-telephone" : item.ActivityType == "Meeting" ? "bi-camera-video" : "bi-envelope") me-1"></i>
                                        @item.ActivityType
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@item.Subject</div>
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        <div class="small text-muted text-truncate" style="max-width: 300px;">@item.Description</div>
                                    }
                                </td>
                                <td>
                                    @if (item.Customer != null)
                                    {
                                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@item.Customer.CustomerId" class="small text-decoration-none">
                                            @item.Customer.CustomerName
                                        </a>
                                    }
                                    else if (item.Lead != null)
                                    {
                                        <a asp-controller="Leads" asp-action="Details" asp-route-id="@item.Lead.LeadId" class="small text-decoration-none">
                                            @item.Lead.LeadName
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td class="small text-muted">@item.ActivityDate.ToString("g")</td>
                                <td>
                                    <span class="badge @(item.Status == "Completed" ? "bg-success" : item.Status == "Planned" ? "bg-warning text-dark" : "bg-danger")">
                                        @item.Status
                                    </span>
                                </td>
                                <td><span class="small text-muted">@assignedName</span></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-clock-history fs-2 d-block mb-2 text-secondary"></i>
                                No activities recorded matching criteria.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (totalPages > 1)
    {
        <div class="card-footer bg-white border-0 py-3">
            <ul class="pagination pagination-sm justify-content-center mb-0">
                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-type="@ViewBag.Type" asp-route-status="@ViewBag.Status">@p</a>
                    </li>
                }
            </ul>
        </div>
    }
</div>
