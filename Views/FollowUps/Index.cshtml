@model IEnumerable<AcxiomCRM.Models.FollowUp>
@{
    ViewData["Title"] = "Follow-Up Management";
    var usersLookup = ViewBag.UsersLookup as Dictionary<string, string> ?? new();
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <h3 class="fw-bold mb-1 text-dark">Follow-Up Management</h3>
        <p class="text-muted small mb-0">Total @ViewBag.TotalCount scheduled customer interactions</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-calendar2-plus me-1"></i> Schedule Follow-Up
        </a>
    </div>
</div>

<!-- Filter Card -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-5">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Planned" selected="@(ViewBag.Status == "Planned")">Planned</option>
                    <option value="Completed" selected="@(ViewBag.Status == "Completed")">Completed</option>
                    <option value="Missed" selected="@(ViewBag.Status == "Missed")">Missed</option>
                    <option value="Cancelled" selected="@(ViewBag.Status == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-md-5">
                <select name="type" class="form-select">
                    <option value="">All Interaction Types</option>
                    <option value="Call" selected="@(ViewBag.Type == "Call")">Call</option>
                    <option value="Meeting" selected="@(ViewBag.Type == "Meeting")">Meeting</option>
                    <option value="Email" selected="@(ViewBag.Type == "Email")">Email</option>
                    <option value="Task" selected="@(ViewBag.Type == "Task")">Task</option>
                </select>
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-outline-secondary">Filter</button>
            </div>
        </form>
    </div>
</div>

<!-- Table Card -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small">
                    <tr>
                        <th>Type</th>
                        <th>Associated Entity</th>
                        <th>Scheduled Date & Time</th>
                        <th>Remarks / Agenda</th>
                        <th>Status</th>
                        <th>Assigned To</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var assignedName = !string.IsNullOrEmpty(item.AssignedTo) && usersLookup.ContainsKey(item.AssignedTo)
                                ? usersLookup[item.AssignedTo]
                                : "Unassigned";

                            var isOverdue = item.Status == "Planned" && item.FollowUpDate < DateTime.UtcNow;

                            <tr>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi @(item.FollowUpType == "Call" ? "bi-telephone" : item.FollowUpType == "Meeting" ? "bi-camera-video" : "bi-envelope") me-1"></i>
                                        @item.FollowUpType
                                    </span>
                                </td>
                                <td>
                                    @if (item.Customer != null)
                                    {
                                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@item.Customer.CustomerId" class="fw-semibold text-decoration-none">
                                            @item.Customer.CustomerName
                                        </a>
                                        <span class="badge bg-light text-muted ms-1">Customer</span>
                                    }
                                    else if (item.Lead != null)
                                    {
                                        <a asp-controller="Leads" asp-action="Details" asp-route-id="@item.Lead.LeadId" class="fw-semibold text-decoration-none">
                                            @item.Lead.LeadName
                                        </a>
                                        <span class="badge bg-light text-muted ms-1">Lead</span>
                                    }
                                    else if (item.Opportunity != null)
                                    {
                                        <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@item.Opportunity.OpportunityId" class="fw-semibold text-decoration-none">
                                            @item.Opportunity.OpportunityName
                                        </a>
                                        <span class="badge bg-light text-muted ms-1">Deal</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td>
                                    <div class="small fw-semibold @(isOverdue ? "text-danger" : "text-dark")">
                                        @item.FollowUpDate.ToString("g")
                                        @if (isOverdue)
                                        {
                                            <span class="badge bg-danger-subtle text-danger ms-1">Overdue</span>
                                        }
                                    </div>
                                </td>
                                <td class="small" style="max-width: 250px;">@item.Remarks</td>
                                <td>
                                    <span class="badge @(item.Status == "Completed" ? "bg-success" : item.Status == "Planned" ? "bg-warning text-dark" : "bg-danger")">
                                        @item.Status
                                    </span>
                                </td>
                                <td><span class="small text-muted">@assignedName</span></td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        @if (item.Status == "Planned")
                                        {
                                            <form asp-action="MarkComplete" asp-route-id="@item.FollowUpId" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-success" title="Mark Completed">
                                                    <i class="bi bi-check2"></i> Done
                                                </button>
                                            </form>
                                        }
                                        <a asp-action="Edit" asp-route-id="@item.FollowUpId" class="btn btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-calendar-x fs-2 d-block mb-2 text-secondary"></i>
                                No follow-ups found matching criteria.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (totalPages > 1)
    {
        <div class="card-footer bg-white border-0 py-3">
            <ul class="pagination pagination-sm justify-content-center mb-0">
                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-status="@ViewBag.Status" asp-route-type="@ViewBag.Type">@p</a>
                    </li>
                }
            </ul>
        </div>
    }
</div>
